{
  "$defs": {
    "ChannelRef": {
      "description": "Where a channel is: in an organization, or in the provider's standalone\nscope when `organization` is `None`.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channel"
      ],
      "type": "object"
    },
    "CompletionRequest": {
      "description": "Completion must not carry out actions. Cursors are opaque; use the same\ncontext, arguments, input and query for subsequent pages.",
      "properties": {
        "call": {
          "$ref": "#/$defs/FunctionCall"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/FunctionInputRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "call",
        "query",
        "limit"
      ],
      "type": "object"
    },
    "Content": {
      "description": "One part of a [`Message`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "required": [
            "Text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Text with styles and mentions. Counts toward the text limit.",
          "properties": {
            "Formatted": {
              "$ref": "#/$defs/FormattedText"
            }
          },
          "required": [
            "Formatted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Image": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Image"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Video": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Video"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Audio": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Audio"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "File": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "File"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Anything else the platform has, such as a sticker or a poll, in a\nformat the provider defines.",
          "properties": {
            "Custom": {
              "properties": {
                "data": {
                  "items": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "data"
              ],
              "type": "object"
            }
          },
          "required": [
            "Custom"
          ],
          "type": "object"
        }
      ]
    },
    "FormattedText": {
      "description": "Text with styled ranges. Ranges can nest and overlap.",
      "properties": {
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "type": "array"
        },
        "text": {
          "description": "The text as it reads without formatting, including a mention's\ndisplay text, such as `@Ana`.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "spans"
      ],
      "type": "object"
    },
    "FunctionCall": {
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object"
        },
        "context": {
          "$ref": "#/$defs/FunctionContext"
        },
        "function": {
          "type": "string"
        }
      },
      "required": [
        "function",
        "context",
        "arguments"
      ],
      "type": "object"
    },
    "FunctionContext": {
      "description": "Providers must check scope, existence and permissions. A message names\nits channel, so it cannot name a conflicting organization.",
      "oneOf": [
        {
          "enum": [
            "Provider"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Organization": {
              "type": "string"
            }
          },
          "required": [
            "Organization"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Channel": {
              "$ref": "#/$defs/ChannelRef"
            }
          },
          "required": [
            "Channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Message": {
              "properties": {
                "channel": {
                  "$ref": "#/$defs/ChannelRef"
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "channel",
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "Message"
          ],
          "type": "object"
        }
      ]
    },
    "FunctionInputRef": {
      "description": "Identifies an input on its parent action/lookup. Helper functions can be\nshared by several functions without losing which input requested them.",
      "properties": {
        "function": {
          "type": "string"
        },
        "input": {
          "type": "string"
        }
      },
      "required": [
        "function",
        "input"
      ],
      "type": "object"
    },
    "Media": {
      "description": "A file carried by a [`Content`].",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/MediaMetadata",
          "default": {
            "description": null,
            "duration_ms": null,
            "expires_at_ms": null,
            "height": null,
            "preview_url": null,
            "spoiler": false,
            "width": null
          }
        },
        "mime": {
          "description": "The MIME type, such as `image/png`, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The file name, if the platform has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "The size in bytes, if known. Ignored for [`MediaSource::Bytes`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/MediaSource"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "MediaMetadata": {
      "description": "Hints for displaying media. Unknown values stay absent; URLs can expire.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "preview_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "spoiler": {
          "type": "boolean"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "spoiler"
      ],
      "type": "object"
    },
    "MediaSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The file itself. The whole message must fit in [`MAX_FRAME`].",
          "properties": {
            "Bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "Bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Where the file can be downloaded without credentials.",
          "properties": {
            "Url": {
              "type": "string"
            }
          },
          "required": [
            "Url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file held by the side that sent the message: the provider in the\nmessages it emits, the orchestrator in its commands. The other side\nreads it in pieces, so it can be any size. Use it too for files only\nthe provider can download, such as ones behind the platform's login.\n\nA provider's blob stays readable until the orchestrator sends\n[`Command::ReleaseBlob`]. Each id belongs to the one event or reply\nit came in: a provider that returns the same file again, such as in\nhistory, gives it a new id, so releasing one never takes the file from\nanother reader. At most [`MAX_ID`] bytes.",
          "properties": {
            "Blob": {
              "type": "string"
            }
          },
          "required": [
            "Blob"
          ],
          "type": "object"
        }
      ]
    },
    "Mention": {
      "description": "Who or what a mention points at. Ids are in the channel's scope.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "User": {
              "type": "string"
            }
          },
          "required": [
            "User"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Channel": {
              "type": "string"
            }
          },
          "required": [
            "Channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A group of users the platform names, such as a Discord role.",
          "properties": {
            "Role": {
              "type": "string"
            }
          },
          "required": [
            "Role"
          ],
          "type": "object"
        },
        {
          "const": "Everyone",
          "description": "Everyone in the channel, such as `@everyone` or `@channel`.",
          "type": "string"
        }
      ]
    },
    "Message": {
      "description": "A message in a channel.",
      "properties": {
        "author": {
          "description": "The author's [`User`] id, in the channel's scope.",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/ChannelRef"
        },
        "content": {
          "description": "The parts of the message, in order, such as a caption and its image.",
          "items": {
            "$ref": "#/$defs/Content"
          },
          "type": "array"
        },
        "edited_at": {
          "description": "When it was last edited, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Unique within the channel.",
          "type": "string"
        },
        "nonce": {
          "description": "The client's id for a message the account sent through\n[`Command::Send`], when the provider can tell which send it is. It\nsettles a send whose answer never came.",
          "type": [
            "string",
            "null"
          ]
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/Reaction"
          },
          "type": "array"
        },
        "reply_to": {
          "description": "The id of the message this replies to, in the same channel.",
          "type": [
            "string",
            "null"
          ]
        },
        "sent_at": {
          "description": "When it was sent, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "channel",
        "author",
        "sent_at",
        "content",
        "reactions"
      ],
      "type": "object"
    },
    "Reaction": {
      "description": "The reactions to a message with one key.",
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "A Unicode emoji such as `👍`, or the provider's id for a custom one.",
          "type": "string"
        },
        "me": {
          "description": "Whether the account is one of them.",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "count",
        "me"
      ],
      "type": "object"
    },
    "Span": {
      "description": "A style over `text[start..end]`, in UTF-8 bytes.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "start",
        "end",
        "style"
      ],
      "type": "object"
    },
    "Style": {
      "oneOf": [
        {
          "enum": [
            "Bold",
            "Italic",
            "Underline",
            "Strikethrough",
            "Code",
            "Quote",
            "Spoiler"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "CodeBlock": {
              "properties": {
                "language": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "required": [
            "CodeBlock"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Link": {
              "type": "string"
            }
          },
          "required": [
            "Link"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Mention": {
              "$ref": "#/$defs/Mention"
            }
          },
          "required": [
            "Mention"
          ],
          "type": "object"
        }
      ]
    },
    "Value": {
      "description": "Files can use blobs inside `Content`. Custom records need no new variants.",
      "oneOf": [
        {
          "enum": [
            "Null"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Boolean": {
              "type": "boolean"
            }
          },
          "required": [
            "Boolean"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Integer": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "Integer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "required": [
            "Text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "Bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "List": {
              "items": {
                "$ref": "#/$defs/Value"
              },
              "type": "array"
            }
          },
          "required": [
            "List"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Record": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "type": "object"
            }
          },
          "required": [
            "Record"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            }
          },
          "required": [
            "Content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Channel": {
              "$ref": "#/$defs/ChannelRef"
            }
          },
          "required": [
            "Channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Message": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "Message"
          ],
          "type": "object"
        }
      ]
    },
    "VerificationRequest": {
      "description": "`call.arguments` holds other inputs, which can still be incomplete.\n`input` names the target input, or is `None` for a standalone check.\nVerification must not carry out the action.",
      "properties": {
        "call": {
          "$ref": "#/$defs/FunctionCall"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/FunctionInputRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "call",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "Functions": {
          "additionalProperties": false,
          "properties": {
            "context": {
              "$ref": "#/$defs/FunctionContext"
            }
          },
          "required": [
            "context"
          ],
          "type": "object"
        }
      },
      "required": [
        "Functions"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "Call": {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "type": "object"
            },
            "context": {
              "$ref": "#/$defs/FunctionContext"
            },
            "function": {
              "type": "string"
            }
          },
          "required": [
            "function",
            "context",
            "arguments"
          ],
          "type": "object"
        }
      },
      "required": [
        "Call"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "Verify": {
          "$ref": "#/$defs/VerificationRequest"
        }
      },
      "required": [
        "Verify"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "Complete": {
          "$ref": "#/$defs/CompletionRequest"
        }
      },
      "required": [
        "Complete"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "History": {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "$ref": "#/$defs/ChannelRef"
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "channel",
            "limit"
          ],
          "type": "object"
        }
      },
      "required": [
        "History"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "GetMessage": {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "$ref": "#/$defs/ChannelRef"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "channel",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "GetMessage"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "Send": {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "$ref": "#/$defs/ChannelRef"
            },
            "content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            },
            "nonce": {
              "type": [
                "string",
                "null"
              ]
            },
            "reply_to": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "channel",
            "content"
          ],
          "type": "object"
        }
      },
      "required": [
        "Send"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "OpenChannel": {
          "additionalProperties": false,
          "properties": {
            "members": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "organization": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "members"
          ],
          "type": "object"
        }
      },
      "required": [
        "OpenChannel"
      ],
      "type": "object"
    }
  ],
  "title": "Command"
}
