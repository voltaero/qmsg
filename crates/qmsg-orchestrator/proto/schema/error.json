{
  "$defs": {
    "ChannelRef": {
      "description": "Where a channel is: in an organization, or in the provider's standalone\nscope when `organization` is `None`.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channel"
      ],
      "type": "object"
    },
    "CommandError": {
      "description": "Why a provider couldn't carry out a [`Command`].",
      "oneOf": [
        {
          "const": "Unsupported",
          "description": "The provider or platform can't do this.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownFunction": {
              "type": "string"
            }
          },
          "required": [
            "UnknownFunction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Invalid function arguments, with codes and messages for each input.",
          "properties": {
            "InvalidInput": {
              "items": {
                "$ref": "#/$defs/InputIssue"
              },
              "type": "array"
            }
          },
          "required": [
            "InvalidInput"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A platform-specific failure with a stable code and optional data,\nsuch as confirmed progress after a partial failure.",
          "properties": {
            "Provider": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "details": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Value"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "Provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownOrganization": {
              "type": "string"
            }
          },
          "required": [
            "UnknownOrganization"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownChannel": {
              "$ref": "#/$defs/ChannelRef"
            }
          },
          "required": [
            "UnknownChannel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownUser": {
              "type": "string"
            }
          },
          "required": [
            "UnknownUser"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownMessage": {
              "type": "string"
            }
          },
          "required": [
            "UnknownMessage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "UnknownBlob": {
              "type": "string"
            }
          },
          "required": [
            "UnknownBlob"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The content breaks the channel's rules or limits.",
          "properties": {
            "Rejected": {
              "$ref": "#/$defs/Violation"
            }
          },
          "required": [
            "Rejected"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Too many requests; try again after this many milliseconds, if the\nplatform says.",
          "properties": {
            "RateLimited": {
              "properties": {
                "retry_after_ms": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "required": [
            "RateLimited"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The account isn't allowed to, such as post in an announcement channel.",
          "properties": {
            "Forbidden": {
              "type": "string"
            }
          },
          "required": [
            "Forbidden"
          ],
          "type": "object"
        },
        {
          "const": "LoginRequired",
          "description": "The account must log in first; see [`ProviderStatus::LoginRequired`].",
          "type": "string"
        },
        {
          "const": "Cancelled",
          "description": "The orchestrator cancelled the command before it was carried out.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Anything else, as the provider describes it.",
          "properties": {
            "Failed": {
              "type": "string"
            }
          },
          "required": [
            "Failed"
          ],
          "type": "object"
        }
      ]
    },
    "Content": {
      "description": "One part of a [`Message`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "required": [
            "Text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Text with styles and mentions. Counts toward the text limit.",
          "properties": {
            "Formatted": {
              "$ref": "#/$defs/FormattedText"
            }
          },
          "required": [
            "Formatted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Image": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Image"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Video": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Video"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Audio": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "Audio"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "File": {
              "$ref": "#/$defs/Media"
            }
          },
          "required": [
            "File"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Anything else the platform has, such as a sticker or a poll, in a\nformat the provider defines.",
          "properties": {
            "Custom": {
              "properties": {
                "data": {
                  "items": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "data"
              ],
              "type": "object"
            }
          },
          "required": [
            "Custom"
          ],
          "type": "object"
        }
      ]
    },
    "ContentKind": {
      "description": "The kinds of [`Content`], used to say what a [`Channel`] accepts.",
      "oneOf": [
        {
          "enum": [
            "Text",
            "Formatted",
            "Image",
            "Video",
            "Audio",
            "File"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Matches [`Content::Custom`] with the same `kind`.",
          "properties": {
            "Custom": {
              "type": "string"
            }
          },
          "required": [
            "Custom"
          ],
          "type": "object"
        }
      ]
    },
    "FormattedText": {
      "description": "Text with styled ranges. Ranges can nest and overlap.",
      "properties": {
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "type": "array"
        },
        "text": {
          "description": "The text as it reads without formatting, including a mention's\ndisplay text, such as `@Ana`.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "spans"
      ],
      "type": "object"
    },
    "InputIssue": {
      "properties": {
        "code": {
          "description": "Provider-defined stable code; clients display `message`.",
          "type": "string"
        },
        "input": {
          "description": "`None` means the issue applies to the whole input set.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Media": {
      "description": "A file carried by a [`Content`].",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/MediaMetadata",
          "default": {
            "description": null,
            "duration_ms": null,
            "expires_at_ms": null,
            "height": null,
            "preview_url": null,
            "spoiler": false,
            "width": null
          }
        },
        "mime": {
          "description": "The MIME type, such as `image/png`, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The file name, if the platform has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "The size in bytes, if known. Ignored for [`MediaSource::Bytes`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/MediaSource"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "MediaMetadata": {
      "description": "Hints for displaying media. Unknown values stay absent; URLs can expire.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "preview_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "spoiler": {
          "type": "boolean"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "spoiler"
      ],
      "type": "object"
    },
    "MediaSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The file itself. The whole message must fit in [`MAX_FRAME`].",
          "properties": {
            "Bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "Bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Where the file can be downloaded without credentials.",
          "properties": {
            "Url": {
              "type": "string"
            }
          },
          "required": [
            "Url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file held by the side that sent the message: the provider in the\nmessages it emits, the orchestrator in its commands. The other side\nreads it in pieces, so it can be any size. Use it too for files only\nthe provider can download, such as ones behind the platform's login.\n\nA provider's blob stays readable until the orchestrator sends\n[`Command::ReleaseBlob`]. Each id belongs to the one event or reply\nit came in: a provider that returns the same file again, such as in\nhistory, gives it a new id, so releasing one never takes the file from\nanother reader. At most [`MAX_ID`] bytes.",
          "properties": {
            "Blob": {
              "type": "string"
            }
          },
          "required": [
            "Blob"
          ],
          "type": "object"
        }
      ]
    },
    "Mention": {
      "description": "Who or what a mention points at. Ids are in the channel's scope.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "User": {
              "type": "string"
            }
          },
          "required": [
            "User"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Channel": {
              "type": "string"
            }
          },
          "required": [
            "Channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A group of users the platform names, such as a Discord role.",
          "properties": {
            "Role": {
              "type": "string"
            }
          },
          "required": [
            "Role"
          ],
          "type": "object"
        },
        {
          "const": "Everyone",
          "description": "Everyone in the channel, such as `@everyone` or `@channel`.",
          "type": "string"
        }
      ]
    },
    "Message": {
      "description": "A message in a channel.",
      "properties": {
        "author": {
          "description": "The author's [`User`] id, in the channel's scope.",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/ChannelRef"
        },
        "content": {
          "description": "The parts of the message, in order, such as a caption and its image.",
          "items": {
            "$ref": "#/$defs/Content"
          },
          "type": "array"
        },
        "edited_at": {
          "description": "When it was last edited, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Unique within the channel.",
          "type": "string"
        },
        "nonce": {
          "description": "The client's id for a message the account sent through\n[`Command::Send`], when the provider can tell which send it is. It\nsettles a send whose answer never came.",
          "type": [
            "string",
            "null"
          ]
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/Reaction"
          },
          "type": "array"
        },
        "reply_to": {
          "description": "The id of the message this replies to, in the same channel.",
          "type": [
            "string",
            "null"
          ]
        },
        "sent_at": {
          "description": "When it was sent, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "channel",
        "author",
        "sent_at",
        "content",
        "reactions"
      ],
      "type": "object"
    },
    "Reaction": {
      "description": "The reactions to a message with one key.",
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "A Unicode emoji such as `👍`, or the provider's id for a custom one.",
          "type": "string"
        },
        "me": {
          "description": "Whether the account is one of them.",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "count",
        "me"
      ],
      "type": "object"
    },
    "Span": {
      "description": "A style over `text[start..end]`, in UTF-8 bytes.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "style": {
          "$ref": "#/$defs/Style"
        }
      },
      "required": [
        "start",
        "end",
        "style"
      ],
      "type": "object"
    },
    "Style": {
      "oneOf": [
        {
          "enum": [
            "Bold",
            "Italic",
            "Underline",
            "Strikethrough",
            "Code",
            "Quote",
            "Spoiler"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "CodeBlock": {
              "properties": {
                "language": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "required": [
            "CodeBlock"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Link": {
              "type": "string"
            }
          },
          "required": [
            "Link"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Mention": {
              "$ref": "#/$defs/Mention"
            }
          },
          "required": [
            "Mention"
          ],
          "type": "object"
        }
      ]
    },
    "Value": {
      "description": "Files can use blobs inside `Content`. Custom records need no new variants.",
      "oneOf": [
        {
          "enum": [
            "Null"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Boolean": {
              "type": "boolean"
            }
          },
          "required": [
            "Boolean"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Integer": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "Integer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string"
            }
          },
          "required": [
            "Text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "Bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "List": {
              "items": {
                "$ref": "#/$defs/Value"
              },
              "type": "array"
            }
          },
          "required": [
            "List"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Record": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "type": "object"
            }
          },
          "required": [
            "Record"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            }
          },
          "required": [
            "Content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Channel": {
              "$ref": "#/$defs/ChannelRef"
            }
          },
          "required": [
            "Channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Message": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "Message"
          ],
          "type": "object"
        }
      ]
    },
    "Violation": {
      "description": "How a message breaks a channel's rules. Parts are numbered from 0.",
      "oneOf": [
        {
          "const": "Empty",
          "description": "The message has no content.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The channel doesn't take the part's kind of content.",
          "properties": {
            "Unsupported": {
              "properties": {
                "kind": {
                  "$ref": "#/$defs/ContentKind"
                },
                "part": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "part",
                "kind"
              ],
              "type": "object"
            }
          },
          "required": [
            "Unsupported"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The channel doesn't take the part's MIME type, or needs one and the\npart has none.",
          "properties": {
            "UnsupportedMime": {
              "properties": {
                "mime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "part": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "part"
              ],
              "type": "object"
            }
          },
          "required": [
            "UnsupportedMime"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`length` is in the rule's [`TextUnit`].",
          "properties": {
            "TextTooLong": {
              "properties": {
                "length": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "max": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "length",
                "max"
              ],
              "type": "object"
            }
          },
          "required": [
            "TextTooLong"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A formatted part has a span outside its text.",
          "properties": {
            "InvalidFormatting": {
              "properties": {
                "part": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "part"
              ],
              "type": "object"
            }
          },
          "required": [
            "InvalidFormatting"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "TooLarge": {
              "properties": {
                "max": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "part": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "size": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "part",
                "size",
                "max"
              ],
              "type": "object"
            }
          },
          "required": [
            "TooLarge"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "TooManyAttachments": {
              "properties": {
                "count": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "max": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "count",
                "max"
              ],
              "type": "object"
            }
          },
          "required": [
            "TooManyAttachments"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "TotalTooLarge": {
              "properties": {
                "max": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "size": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "size",
                "max"
              ],
              "type": "object"
            }
          },
